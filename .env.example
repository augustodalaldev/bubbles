# --- Django ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=change-me
# Required in production (>= 32 chars, not the placeholder above)
# Only used outside dev (dev.py already allows localhost); required in production
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Frontend origin allowed by CORS
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- PostgreSQL (read by docker-compose.yml AND by Django) ---
POSTGRES_DB=bubbles
POSTGRES_USER=bubbles
POSTGRES_PASSWORD=bubbles_dev_password
POSTGRES_HOST=localhost
# Change to 5433 if you already have a local PostgreSQL on 5432
POSTGRES_PORT=5432

# --- Production only (config.settings.prod) ---
# Full origins (with scheme) allowed to submit admin forms over HTTPS
# DJANGO_CSRF_TRUSTED_ORIGINS=https://bubbles.example.com
# Set to true when a reverse proxy terminates TLS and sends X-Forwarded-Proto
# DJANGO_BEHIND_PROXY=false
# DJANGO_SECURE_SSL_REDIRECT=true
# HSTS max-age in seconds; raise gradually (3600 -> 86400 -> 31536000) once HTTPS is stable
# DJANGO_SECURE_HSTS_SECONDS=3600
